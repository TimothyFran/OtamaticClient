{
    "name": "OtamaticClient",
    "version": "1.0.0",
    "description": "Managed OTA updates for ESP32 through the Otamatic platform, for the Arduino framework and plain ESP-IDF.",
    "keywords": "ota, update, firmware, esp32, wireless",
    "license": "BUSL-1.1",
    "homepage": "https://github.com/TimothyFran/OtamaticClient",
    "repository": {
        "type": "git",
        "url": "https://github.com/TimothyFran/OtamaticClient.git"
    },
    "authors": [
        {
            "name": "Timothy Franceschi",
            "email": "timothy@franceschi.es",
            "maintainer": true
        }
    ],
    "frameworks": ["arduino", "espidf"],
    "platforms": "espressif32",
    "dependencies": [
        {
            "owner": "bblanchon",
            "name": "ArduinoJson",
            "version": "^7.0.0"
        }
    ],
    "export": {
        "exclude": [
            ".github",
            ".vscode",
            ".clinerules",
            "context7.json",
            "build",
            "examples/esp-idf/*/build",
            "examples/esp-idf/*/managed_components",
            "examples/esp-idf/*/sdkconfig",
            "examples/esp-idf/*/dependencies.lock"
        ]
    }
}
